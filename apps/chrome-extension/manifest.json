{
  "manifest_version": 3,
  "name": "MeetMonitor - Student Companion",
  "version": "1.0.0",
  "description": "Monitors class participation, supports 20s checks, AFK breaks, and private notes on Google Meet.",
  "permissions": [
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:4000/*",
    "http://127.0.0.1:4000/*",
    "https://*/*",
    "https://class-companion-56q5.onrender.com/"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "scripts": [
      "src/background/service-worker.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/config.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "MeetMonitor Student Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "meetmonitor@project-cephalon.local",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}